# Copy this file to ".env" and fill in your own keys. ".env" is gitignored.

# WeatherAPI via RapidAPI — https://rapidapi.com/weatherapi/api/weatherapi-com
WEATHERAPI_RAPIDAPI_KEY=
WEATHERAPI_RAPIDAPI_HOST=weatherapi-com.p.rapidapi.com

# Climatiq — https://www.climatiq.io/docs/guides/quickstart
CLIMATIQ_API_KEY=
